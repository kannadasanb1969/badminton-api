{
  "name": "badminton-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --env-file .dev.vars --var AUTH_MODE:development --var ENVIRONMENT:local",
    "start": "wrangler dev --env-file .dev.vars --var AUTH_MODE:development --var ENVIRONMENT:local",
    "test": "vitest",
    "db:check-target": "node scripts/check-db-target.mjs",
    "db:verify-friendly-schema": "node scripts/verify-friendly-schema.mjs",
    "db:verify-friendly-cleanup": "node scripts/verify-friendly-cleanup-smoke.mjs",
    "db:migrate:friendly:test": "node scripts/run-friendly-migration.mjs",
    "db:seed:knockout-dev": "node scripts/seed-knockout-dev.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "vitest": "~4.1.0",
    "wrangler": "^4.130.0"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
